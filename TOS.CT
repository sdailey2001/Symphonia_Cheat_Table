[ENABLE]

aobscanmodule(DisableRStickX,TOS.exe,89 51 20 8B 50 2C) // should be unique
aobscanmodule(DisableRStickY,TOS.exe,89 51 24 8B 50 30) // should be unique
alloc(Mem_DisableRStickX,128)
alloc(Mem_DisableRStickY,128)


Mem_DisableRStickX:
  xor edx,edx

Code_DisableRStickX:
  mov [ecx+20],edx
  mov edx,[eax+2C]
  jmp Ret_DisableRStickX

DisableRStickX:
  jmp Mem_DisableRStickX
  nop
Ret_DisableRStickX:
//============================================================================//
Mem_DisableRStickY:
  cmp byte [TOS.exe+712CEC],0  //If in Battle
  je Code_DisableRStickY
  test byte [PauseState],1
  jne Code_DisableRStickY
  push edx
  test edx,edx
  jge ObtainedABS
  neg edx
ObtainedABS:
  cmp edx,738E  //Deadzone
  jl StickDeadzone
  pop edx

  cmp edx,0
  jl TestLow
  movzx edx,word [esi+10]
  or dx,800
  jmp ReassignEnd
TestLow:
  movzx edx,word [esi+10]
  or dx,400
ReassignEnd:
  mov [esi+10],edx
  jmp ClearStickY
StickDeadzone:
  pop edx
ClearStickY:
  xor edx,edx
Code_DisableRStickY:
  mov [ecx+24],edx
  mov edx,[eax+30]
  jmp Ret_DisableRStickY

DisableRStickY:
  jmp Mem_DisableRStickY
  nop
