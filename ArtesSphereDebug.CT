    <CheatEntry>
      <ID>38</ID>
      <Description>"Inputs"</Description>
      <Options moManualExpandCollapse="1"/>
      <Color>00FFFF</Color>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>{ Game   : TOS.exe
  Version:
