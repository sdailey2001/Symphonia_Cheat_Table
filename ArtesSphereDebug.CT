[ENABLE]

aobscanmodule(ButtonInputs,TOS.exe,89 4E 10 8B D1) // should be unique
alloc(Mem_ButtonInputs,$1000,ButtonInputs)
alloc(ControlID,1)
alloc(LoopCounter,3)
alloc(MainControls,2)
alloc(StoredControls,64)
alloc(PageSwitch,2)

registersymbol(ControlID)
registersymbol(LoopCounter)
registersymbol(MainControls)
registersymbol(StoredControls)
registersymbol(PageSwitch)
registersymbol(MainArtes)
registersymbol(StoredArtes)

define(MainArtes,CharPtr+D8)
define(StoredArtes,ArteStoragePtr)


Mem_ButtonInputs:
  push eax
  push esi
  push edi
  call Func_GetInputs
  //cmp byte [ControlID],0  //DEBUG for P1
  //jne IncID               //DEBUG JMP for P1
  movzx eax,byte [ControlID]  //
  cmp byte [PartyPtr+eax],0   //Check if Controller has Char
  je IncID                    //

  test byte [TOS.exe+712CEC],1  //If in Battle
  jz PageCheck
  cmp byte [PauseState],0       //If Game is Not Paused
  jne PageCheck
  movzx ebx,byte [ControlID]
  call Func_GetPartySlot
  test byte [UnisonState],1  //Check if in Unison Attack
  jnz UnisonStart
  call Func_GetController
  cmp byte [StoredControls+eax+8],0  //Check if [LB] is Pressed
  je ResetPage
  jmp SkipUnison
UnisonStart:
  cmp byte [StoredControls+8],0  //Check if P1 [LB] is Not Pressed
  je ResetPage              //Jump if Equal
SkipUnison:
  or word [PageSwitch],bx  //Set Page Flag
  and word [MainControls],FEFF
  call Func_UpdatePages
  jmp IncID
ResetPage:
  not ebx
  and word [PageSwitch],bx  //Clear Page Flag
  call Func_UpdatePages
  jmp IncID

PageCheck:  //Check for an Active Page
  test byte [ArtesPageState],1  //Check if Artes Page is Open
  jnz ArtesPageCheck
  test byte [UnisonPageState],1  //Check if Unison Page is Open
  jnz UnisonPageCheck
ResetAllPages:
  mov word [PageSwitch],0
  cmp word [StoredArtes+7E],0
  je IncID
  call Func_UpdatePages
  jmp IncID  //End

UnisonPageCheck:
  test word [TOS.exe+182BBF0],1  //Check if Selecting Arte
  jnz IncID
  movzx ecx word [TOS.exe+182BC06]  //Current Unison Char
  mov ebx,1
  shl ebx,cl
  jmp MergePageCheck
ArtesPageCheck:
  cmp word [TOS.exe+70DDB0],3  //Check Cursor Area for Selecting Arte
  je SkipResetAllPages
  test byte [ShortcutState],1
  jnz IncID
  cmp word [TOS.exe+70DDB0],2  //Check Cursor Area for Input Select
  jne ResetAllPages
  movzx ebx,byte [TOS.exe+70DDBE]  //Get Current Char Page Slot
  call Func_GetPartySlot
MergePageCheck:
  cmp word [StoredArtes+7E],0  //Check if Artes Page Switched
  je SkipResetAllPages
  test word [StoredArtes+7E],bx
  jz ResetAllPages
SkipResetAllPages:
  call Func_GetController            //
  cmp byte [StoredControls+eax+5],1  //Check if [Select] is Pressed
  jne IncID                          //
  xor word [PageSwitch],bx  //Set Char Page to Switch
  mov ecx,1F           //Sound ID
  call TOS.exe+17D510  //Play Sound Effect
  call Func_UpdatePages
  jmp IncID  //End


//=============//
//  Functions  //
//=============//

Func_GetInputs:
  mov word [MainControls],cx
  mov eax,10
  mul byte [ControlID]
  mov edx,eax
GetInputsLoop:
  movzx ecx,byte [LoopCounter]
  mov eax,1
  shl ax,cl
  add ecx,edx
  test word [MainControls],ax
  jz ReleasedButton
  cmp byte [StoredControls+ecx],1E  //Check if Button is Held for 1 Sec
  jae GetInputsEnd
  inc byte [StoredControls+ecx]
  jmp GetInputsEnd
ReleasedButton:
  mov byte [StoredControls+ecx],0
GetInputsEnd:
  inc byte [LoopCounter]          //Increase Loop Count
  cmp byte [LoopCounter],10       //
  jb GetInputsLoop                //Jump if Loop Count is Below Target
  mov byte [LoopCounter],0
  ret

Func_ResetPage:  //Requires EBX to have Char to Reset
  not ebx
  and word [PageSwitch],bx
  ret

Func_ResetAllPages:
  mov word [PageSwitch],0
  call Func_UpdatePages
  ret

Func_UpdatePages:  //Swap Artes Between Main and Alt
  lea esi,[StoredArtes]
  lea edi,[MainArtes]
UpdatePagesLoopMain:
  movzx ecx,byte [LoopCounter]
  movzx ebx,word [PageSwitch]
  movzx eax,word [StoredArtes+7E]
  shr ax,cl
  shr bx,cl
  and ax,1
  and bx,1
  cmp bx,ax
  je SkipUpdatePage
UpdatePagesLoopSub:
  mov ecx,[esi]   //Load 4 Bytes from Main Artes to Register
  xchg ecx,[edi]  //Exchange 4 Bytes Between Stored Artes &amp; Register
  mov [esi],ecx   //Exchange 4 Bytes Between Main Artes &amp; Register
  add esi,4
  add edi,4
  inc byte [LoopCounter+1]    //
  cmp byte [LoopCounter+1],4  //
  jb UpdatePagesLoopSub       //
  mov byte [LoopCounter+1],0  //
  sub esi,2
  sub edi,2
  movzx ecx,word [esi]  //Load 2 Bytes from Main Artes to Register
  xchg cx,word [edi]    //Exchange 2 Bytes Between Stored Artes &amp; Register
  mov word [esi],cx          //Exchange 2 Bytes Between Main Artes &amp; Register
  sub esi,E
  sub edi,E
SkipUpdatePage:
  add esi,E
  add edi,118
  inc byte [LoopCounter]    //
  cmp byte [LoopCounter],9  //
  jb UpdatePagesLoopMain    //
  mov byte [LoopCounter],0  //
  movzx ebx,word [PageSwitch]
  mov word [StoredArtes+7E],bx
  ret

Func_GetPartySlot:
  movzx ecx,byte [PartyPtr+ebx]    //Get Current Char Slot
  sub ecx,1
  mov ebx,1
  shl ebx,cl
  ret

Func_GetController:
  mov eax,10
  mul byte [ControlID]
  ret

IncID:
  inc byte [ControlID]
  cmp byte [ControlID],4
  jb Code_ButtonInputs
  mov byte [ControlID],0

Code_ButtonInputs:
  pop edi
  pop esi
  pop eax
  movzx ecx,word [MainControls]
  mov [esi+10],ecx
  mov edx,ecx
  jmp Ret_ButtonInputs
{
ControlID:
db (int)-1
}

InputIndex:
  db 01 02 04 08 10 20 40 80

ButtonInputs:
  jmp Mem_ButtonInputs
Ret_ButtonInputs:
registersymbol(ButtonInputs)

[DISABLE]

ButtonInputs:
  db 89 4E 10 8B D1


unregistersymbol(StoredArtes)
unregistersymbol(MainArtes)
unregistersymbol(PageSwitch)
unregistersymbol(StoredControls)
unregistersymbol(MainControls)
unregistersymbol(LoopCounter)
unregistersymbol(ControlID)
unregistersymbol(ButtonInputs)

dealloc(PageSwitch)
dealloc(StoredControls)
dealloc(MainControls)
dealloc(LoopCounter)
dealloc(ControlID)
dealloc(Mem_ButtonInputs)

{
// ORIGINAL Code_ButtonInputs - [INPUTS] INJECTION POINT: TOS.exe+20CC53

TOS.exe+20CC3F: CC        - int 3
