TOS.exe+20CC5A: 8B FA     - mov edi,edx
TOS.exe+20CC5C: 23 F9     - and edi,ecx
TOS.exe+20CC5E: 89 7E 14  - mov [esi+14],edi
TOS.exe+20CC61: F7 D1     - not ecx
TOS.exe+20CC63: 23 CA     - and ecx,edx
TOS.exe+20CC65: 8B 50 08  - mov edx,[eax+08]
TOS.exe+20CC68: 89 4E 18  - mov [esi+18],ecx
TOS.exe+20CC6B: 89 56 20  - mov [esi+20],edx
}
</AssemblerScript>
